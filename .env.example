# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# The robot's ESP32 serial port (Windows: COM3, COM4... / Mac: /dev/cu.usbserial-...)
ROBOT_COM_PORT=COM3

# Database file (relative to the project folder)
DB_PATH=data/guide.db

# Any long random text. Keeps staff logged in across restarts of the admin site.
SESSION_SECRET=change-me-to-a-long-random-text
